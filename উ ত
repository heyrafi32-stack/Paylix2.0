            const email = document.getElementById('unlimited-base-email').value.trim();
            const box = document.getElementById('unlimited-output-box');
            if(!email.includes('@gmail.com')) { alert('সঠিক জিমেইল দিন'); return; }
            const name = email.split('@')[0];
            let list = [];
            for(let i=1; i<name.length; i++) list.push(name.slice(0,i) + '.' + name.slice(i) + '@gmail.com');
            box.innerHTML = list.map(x => '<div>• ' + x + '</div>').join('');
            box.classList.remove('hidden');
        }

        window.handleUserWithdraw = async (e) => {
            e.preventDefault();
            alert('উইথড্র রিকোয়েস্ট জমা হয়েছে!');
            closeWithdrawModal();
        };
        window.handleUserDepositSubmit = async (e) => {
            e.preventDefault();
            alert('ডিপোজিট রিকোয়েস্ট পেন্ডিং আছে!');
            closeDepositModal();
        };
    </script>
</body>
</html>
