        onAuthStateChanged(auth, async (user) => {
            if (user) {
                document.getElementById('auth-screen').classList.add('hidden');
                document.getElementById('app').classList.remove('hidden');

                onSnapshot(doc(db, "users", user.uid), (docSnap) => {
                    if (docSnap.exists()) {
                        window.currentUserDoc = docSnap.data();
                        window.currentUserDoc.uid = user.uid;
                        updateUserUI(window.currentUserDoc);
                        loadReferredMembers(window.currentUserDoc.referralCode);
                    }
                });

                onSnapshot(collection(db, "gmail_submissions"), (snapshot) => {
                    let list = [];
                    snapshot.forEach(d => list.push({ id: d.id, ...d.data() }));
                    renderAdminSubmissions(list);
                    renderUserHistory(list, []);
                });

                onSnapshot(collection(db, "withdraw_requests"), (snapshot) => {
                    let list = [];
                    snapshot.forEach(d => list.push({ id: d.id, ...d.data() }));
                    renderUserHistory([], list);
                });

                onSnapshot(collection(db, "tasks"), (snapshot) => {
                    let tasks = [];
                    snapshot.forEach(d => tasks.push({ id: d.id, ...d.data() }));
                    renderRealTasks(tasks);
                });
            } else {
                document.getElementById('auth-screen').classList.remove('hidden');
                document.getElementById('app').classList.add('hidden');
            }
        });

        window.handleUserRegister = async (e) => {
            e.preventDefault();
            const name = document.getElementById('user-name-reg').value;
            const email = document.getElementById('user-email-reg').value;
            const pass = document.getElementById('user-pass-reg').value;
            const refCode = document.getElementById('user-ref-reg').value.trim();
            const myRef = name.replace(/\s+/g, '').toLowerCase() + Math.floor(1000 + Math.random() * 9000);

            try {
                const res = await createUserWithEmailAndPassword(auth, email, pass);
                await setDoc(doc(db, "users", res.user.uid), {
                    uid: res.user.uid,
                    name: name,
                    email: email,
                    balance: 0.00,
                    referralCode: myRef,
                    referredByCode: refCode || '',
                    totalRefers: 0,
                    isBlocked: false,
                    createdAt: new Date().toISOString()
                });
                alert('রেজিস্ট্রেশন সফল হয়েছে!');
            } catch (err) {
                alert('ত্রুটি: ' + err.message);
            }
        };

        window.handleUserLogin = async (e) => {
            e.preventDefault();
            const email = document.getElementById('user-email-login').value;
            const pass = document.getElementById('user-pass-login').value;
            try {
                await signInWithEmailAndPassword(auth, email, pass);
            } catch (err) {
                alert('ইমেইল বা পাসওয়ার্ড ভুল!');
            }
        };

        window.handleUserLogout = () => signOut(auth);

        // PENDING SUBMISSION LOGIC (NO INSTANT BALANCE)
        window.submitGmailToFirestore = async (e) => {
            e.preventDefault();
            const email = document.getElementById('home-gmail-input')?.value || document.getElementById('service-gmail-input')?.value;
            const pass = document.getElementById('home-gmail-pass')?.value || document.getElementById('service-gmail-pass')?.value;

            try {
                await addDoc(collection(db, "gmail_submissions"), {
                    type: 'Gmail',
                    account: email,
                    password: pass,
                    submittedBy: auth.currentUser.email,
                    userUid: auth.currentUser.uid,
                    status: 'pending',
                    rate: 15.00,
                    submittedAt: new Date().toLocaleString()
                });
                alert('জিমেইল সফলভাবে জমা হয়েছে এবং বর্তমানে PENDING অবস্থায় আছে। অ্যাডমিন অ্যাপ্রুভ করলে ব্যালেন্সে টাকা যোগ হবে।');
                if(document.getElementById('home-gmail-input')) document.getElementById('home-gmail-input').value = '';
                if(document.getElementById('home-gmail-pass')) document.getElementById('home-gmail-pass').value = '';
                if(document.getElementById('service-gmail-input')) document.getElementById('service-gmail-input').value = '';
                if(document.getElementById('service-gmail-pass')) document.getElementById('service-gmail-pass').value = '';
            } catch(err) {
                alert('ত্রুটি: ' + err.message);
            }
        };

        window.submitSocialAccount = async (e, type, rate) => {
            e.preventDefault();
            const userAcc = document.getElementById(type === 'Facebook' ? 'fb-input-uid' : 'insta-input-user').value;
            const pass = document.getElementById(type === 'Facebook' ? 'fb-input-pass' : 'insta-input-pass').value;

            try {
                await addDoc(collection(db, "gmail_submissions"), {
                    type: type,
                    account: userAcc,
                    password: pass,
                    submittedBy: auth.currentUser.email,
                    userUid: auth.currentUser.uid,
                    status: 'pending',
                    rate: rate,
                    submittedAt: new Date().toLocaleString()
                });
                alert(type + ' একাউন্ট সাবমিট হয়েছে এবং PENDING আছে।');
            } catch(err) {
                alert('ত্রুটি: ' + err.message);
            }
        };

        // ADMIN APPROVAL
        window.adminApproveSub = async (id, userUid, rate) => {
            try {
                await updateDoc(doc(db, "gmail_submissions", id), { status: 'approved' });
                if(userUid) {
                    const uRef = doc(db, "users", userUid);
                    const uSnap = await getDoc(uRef);
                    if(uSnap.exists()) {
                        const curBal = uSnap.data().balance || 0;
                        await updateDoc(uRef, { balance: curBal + rate });
                    }
                }
                alert('অ্যাপ্রুভ করা হয়েছে এবং ইউজারের ওয়ালেটে টাকা যোগ হয়েছে!');
            } catch(err) {
                alert('ত্রুটি: ' + err.message);
            }
        };

        window.adminRejectSub = async (id) => {
            await updateDoc(doc(db, "gmail_submissions", id), { status: 'rejected' });
            alert('রিজেক্ট করা হয়েছে!');
        };

        function updateUserUI(uData) {
            document.getElementById('dash-user-name').innerText = uData.name;
            document.getElementById('home-total-asset').innerText = '৳' + (uData.balance || 0).toFixed(2);
            document.getElementById('wallet-balance-display').innerText = '৳' + (uData.balance || 0).toFixed(2);
            document.getElementById('profile-name-display').innerText = uData.name;
            document.getElementById('network-ref-code').innerText = uData.referralCode;
        }

        function loadReferredMembers(code) {
            const q = query(collection(db, "users"), where("referredByCode", "==", code));
            onSnapshot(q, (snap) => {
                let count = 0;
                const container = document.getElementById('referred-users-container');
                container.innerHTML = '';
                snap.forEach(d => {
                    count++;
                    const u = d.data();
                    container.innerHTML += '<div class="bg-slate-50 p-2 rounded-xl border border-slate-200 flex justify-between"><span>' + u.name + '</span><span class="text-emerald-600 font-bold">Joined</span></div>';
                });
                document.getElementById('ref-count-badge').innerText = count;
            });
        }

        function renderAdminSubmissions(list) {
            const tbody = document.getElementById('admin-submissions-body');
            if(!tbody) return;
            tbody.innerHTML = '';
            list.forEach(item => {
                let actions = item.status === 'pending' ? '<button onclick="adminApproveSub('' + item.id + '', '' + item.userUid + '', ' + item.rate + ')" class="bg-emerald-600 px-2 py-1 rounded font-bold mr-1">Approve</button><button onclick="adminRejectSub('' + item.id + '')" class="bg-red-600 px-2 py-1 rounded font-bold">Reject</button>' : '<span class="capitalize text-slate-400">' + item.status + '</span>';

                tbody.innerHTML += '<tr class="border-b border-slate-800"><td class="p-2 text-sky-400 font-bold">' + item.type + '</td><td class="p-2">' + item.account + '</td><td class="p-2 font-mono text-amber-400">' + item.password + '</td><td class="p-2 text-slate-400">' + item.submittedBy + '</td><td class="p-2 font-bold">' + item.status + '</td><td class="p-2">' + actions + '</td></tr>';
            });
        }

        function renderUserHistory(subs, withdraws) {
            const body = document.getElementById('history-list-body');
            if(!body || !auth.currentUser) return;
            body.innerHTML = '';
            const mySubs = subs.filter(s => s.userUid === auth.currentUser.uid);
            mySubs.forEach(item => {
                body.innerHTML += '<div class="bg-slate-50 p-3 rounded-2xl border border-slate-200 flex justify-between items-center"><div><p class="font-bold text-slate-800">' + item.type + ' Submission</p><p class="text-[10px] text-slate-400">' + item.submittedAt + '</p></div><div class="text-right"><p class="font-bold text-emerald-600">+৳' + item.rate + '.00</p><p class="text-[10px] font-bold uppercase text-amber-500">' + item.status + '</p></div></div>';
            });
        }

        function renderRealTasks(taskList) {
            const container = document.getElementById('task-list-container');
            if(!container) return;
            container.innerHTML = '';
            taskList.forEach(t => {
                container.innerHTML += '<div class="bg-white p-4 rounded-3xl border border-slate-100 shadow-sm flex items-center justify-between"><div><h4 class="font-bold text-sm text-slate-800">' + t.title + '</h4><p class="text-emerald-600 font-extrabold text-xs">৳' + t.reward + '.00</p></div><button onclick="alert('টাস্ক সম্পন্ন হয়েছে!')" class="bg-[#059669] text-white px-4 py-2 rounded-2xl text-xs font-bold">Start</button></div>';
            });
        }
